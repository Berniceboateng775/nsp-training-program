{
  "name": "vellichor-ai",
  "version": "1.0.0",
  "description": "Vellichor AI — Your Intelligent Reading Companion",
  "scripts": {
    "start": "concurrently \"npm run backend\" \"npm run frontend\"",
    "dev": "concurrently \"npm run backend\" \"npm run frontend\"",
    "backend": "cd backend && uvicorn main:app --reload --port 8000",
    "frontend": "cd frontend && npx -y http-server . -p 3000 -o -c-1 --cors",
    "backend:only": "cd backend && uvicorn main:app --reload --port 8000",
    "frontend:only": "cd frontend && npx -y http-server . -p 3000 -o -c-1 --cors"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
